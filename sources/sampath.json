{
  "id": "sampath",
  "name": "Sampath Bank",
  "kind": "api",
  "policy": {
    "robots": "none published",
    "delayMs": 1200,
    "userAgent": "cardstock/0.1 (+https://cardstock.anjula.dev/about)"
  },
  "requests": [
    {
      "name": "promotions",
      "url": "https://www.sampath.lk/api/card-promotions",
      "headers": {
        "locale": "en",
        "platform": "web",
        "Referer": "https://www.sampath.lk/sampath-cards/credit-card-offer"
      }
    }
  ],
  "categoryMap": {
    "super_markets": "supermarket",
    "dining": "dining",
    "hotels": "travel",
    "travel_and_leisure": "travel",
    "fashion": "fashion",
    "online": "online",
    "health_and_insurance": "health",
    "Electronics_and_Furniture": "electronics",
    "Premium_Offers": "other",
    "Mastercard_Offers": "other",
    "VISA_Offers": "other",
    "Other": "other"
  },
  "sourceUrlTemplate": "https://www.sampath.lk/sampath-cards/credit-card-offer/{id}",
  "cadence": "0 6,18 * * *",
  "guards": {
    "minItems": 80,
    "maxDropRatio": 0.25,
    "requireFields": ["id", "title", "validTo", "bank", "sourceUrl"]
  }
}
